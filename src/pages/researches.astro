---
import Layout from "../layouts/Layout.astro";
import FilterBar from "../components/FilterBar.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import { getAllPapers } from "../lib/papers";
import { slugifySectionId } from "../lib/section-id";
import siteConfig from "../side.config";

const papers = getAllPapers();
const categoryOrder = [
  "Publication",
  "Working Paper",
  "Work in Progress",
  "Other",
] as const;
const grouped = new Map<string, typeof papers>();

for (const paper of papers) {
  const category = paper.category ?? "Other";
  if (!grouped.has(category)) {
    grouped.set(category, []);
  }
  grouped.get(category)?.push(paper);
}

const orderedCategories = [
  ...categoryOrder.filter((category) => grouped.has(category)),
  ...Array.from(grouped.keys())
    .filter(
      (category) =>
        !categoryOrder.includes(category as (typeof categoryOrder)[number]),
    )
    .sort((a, b) => a.localeCompare(b)),
];

// Category icons mapping
const categoryIcons: Record<string, string> = {
  "Publication": "i-mdi:file-document-check",
  "Working Paper": "i-mdi:file-document-edit",
  "Work in Progress": "i-mdi:file-document-outline",
  "Other": "i-mdi:file-document",
};

// Count total papers
const totalPapers = papers.length;
const pageTitle = siteConfig.pageTitles.researches.title || "Publications";
const pageDescription = siteConfig.pageTitles.researches.description || 
  "Peer-reviewed publications, workshop papers, and essays focusing on the flow of learning signals across scholarly and civic platforms.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="space-y-6">
    <!-- Page Header -->
    <header class="space-y-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-50">
          {pageTitle}
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
          {pageDescription}
        </p>
      </div>
      
      <FilterBar
        total={totalPapers}
        allIcon="i-mdi:file-document-multiple"
        items={orderedCategories.map((category) => ({
          filter: slugifySectionId(category),
          label: category.toLowerCase(),
          count: grouped.get(category)?.length || 0,
          icon: categoryIcons[category] || "i-mdi:file-document",
        }))}
      />
    </header>

    <PageJumpNav
      items={orderedCategories.map((category) => ({
        href: `#${slugifySectionId(category)}`,
        label: category,
      }))}
    />

    <div class="fade-in-up animation-delay-200 space-y-8" id="papers-container">
      {
        orderedCategories.map((category) => {
          const categoryPapers = grouped.get(category);
          if (!categoryPapers?.length) {
            return null;
          }
          const categorySlug = slugifySectionId(category);

          return (
            <section id={categorySlug} class="scroll-mt-20 space-y-3 paper-section" data-filter-section={categorySlug}>
              <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                {category} <span class="text-gray-400 dark:text-gray-500 font-normal">({categoryPapers.length})</span>
              </h2>
              
              <div class="space-y-3">
                {categoryPapers.map((paper, index) => {
                  const abstractId = `abstract-${paper.id}`;
                  const hasAbstract = Boolean(paper.abstract);

                  return (
                    <article class="group relative pt-4 pb-6 pl-8 pr-6 rounded-2xl bg-white dark:bg-gray-800/50 shadow-sm hover:shadow-md transition-shadow duration-300">
                      <!-- Index badge -->
                      <div class="absolute -left-2 -top-2 w-7 h-7 flex items-center justify-center rounded-lg bg-accent-600 dark:bg-accent-500 text-white text-xs font-bold shadow-md">
                        {index + 1}
                      </div>
                      
                      <div class="space-y-2">
                        <!-- Title -->
                        <div class="pr-6">
                        <h3 class="font-bold text-gray-900 dark:text-gray-50 leading-snug">
                          {paper.url ? (
                            <a
                              href={paper.url}
                              target="_blank"
                              rel="noreferrer"
                              class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors no-underline text-inherit inline-flex items-start gap-1"
                            >
                              {paper.title}
                              <span class="i-mdi:open-in-new text-xs text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity shrink-0 mt-1"></span>
                            </a>
                          ) : paper.title}
                        </h3>
                        </div>
                        
                        <!-- Authors -->
                        {paper.authors.length > 0 && (
                          <p class="text-sm text-gray-600 dark:text-gray-300 flex items-center gap-1.5">
                            <span class="i-mdi:account-group text-gray-400 dark:text-gray-500 shrink-0"></span>
                            {paper.authors.join(", ")}
                          </p>
                        )}
                        
                        <!-- Footer: Meta & Actions -->
                        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 mt-1 border-t border-gray-100 dark:border-gray-800/50">
                          <!-- Meta info (Left) -->
                          <div class="flex flex-wrap items-center gap-2">
                            {paper.venue && (
                              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold text-accent-800 dark:text-accent-200 bg-accent-100 dark:bg-accent-900/40 border border-accent-200 dark:border-accent-800">
                                <span class="i-mdi:bookmark text-accent-600 dark:text-accent-300"></span>
                                {paper.venue}
                              </span>
                            )}
                            {paper.year && (
                              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
                                <span class="i-mdi:calendar text-gray-500 dark:text-gray-400"></span>
                                {paper.year}
                              </span>
                            )}
                          </div>
                          
                          <!-- Actions (Right) -->
                          <div class="flex items-center gap-2">
                            {hasAbstract && (
                              <button
                                class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 hover:bg-accent-100 hover:text-accent-700 dark:bg-gray-800 dark:hover:bg-accent-900/40 dark:hover:text-accent-300 rounded-lg border-none cursor-pointer transition-colors"
                                type="button"
                                data-abstract-toggle
                                data-target={abstractId}
                                aria-controls={abstractId}
                                aria-expanded="false"
                              >
                                <span data-abstract-icon class="i-mdi:chevron-down text-base transition-transform duration-200"></span>
                                Abstract
                              </button>
                            )}
                            {paper.url && (
                              <a 
                                href={paper.url}
                                target="_blank"
                                rel="noreferrer"
                                class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 hover:bg-accent-100 hover:text-accent-700 dark:bg-gray-800 dark:hover:bg-accent-900/40 dark:hover:text-accent-300 rounded-lg border-none no-underline transition-colors"
                              >
                                <span class="i-mdi:file-pdf-box text-base"></span>
                                PDF
                              </a>
                            )}
                          </div>
                        </div>

                        {hasAbstract && (
                          <div hidden class="hidden mt-3 p-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400 bg-gradient-to-br from-gray-50 to-gray-100/50 dark:from-gray-800/50 dark:to-gray-800/30 rounded-lg border-l-3 border-accent-500" id={abstractId}>
                            <div class="flex items-start gap-2">
                              <span class="i-mdi:format-quote-open text-lg text-accent-400 shrink-0 mt-0.5"></span>
                              <p class="flex-1">{paper.abstract}</p>
                            </div>
                          </div>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  import { setupAbstractToggles, setupFilterControls } from "../scripts/ui";

  setupAbstractToggles();
  setupFilterControls();
</script>
