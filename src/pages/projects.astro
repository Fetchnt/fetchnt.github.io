---
import Layout from "../layouts/Layout.astro";
import FilterBar from "../components/FilterBar.astro";
import { projects } from "../components/projects";
import siteConfig from "../side.config";
import { getProjectStatus } from "../lib/projects";

const pageTitle = siteConfig.pageTitles.projects.title || "Projects";
const pageDescription = siteConfig.pageTitles.projects.description ||
  "Selected lab and community projects with a focus on reproducible research infrastructure, learning analytics, and open collaboration.";

const activeProjects = projects.filter((project) => getProjectStatus(project) === "active");
const pastProjects = projects.filter((project) => getProjectStatus(project) === "past");
const unspecifiedProjects = projects.filter((project) => getProjectStatus(project) === "unspecified");
const filterItems = [
  {
    filter: "active",
    label: "active",
    count: activeProjects.length,
    icon: "i-mdi:rocket-launch",
  },
  {
    filter: "past",
    label: "past",
    count: pastProjects.length,
    icon: "i-mdi:archive",
  },
  {
    filter: "unspecified",
    label: "other",
    count: unspecifiedProjects.length,
    icon: "i-mdi:folder-open",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="space-y-6">
    <!-- Page Header -->
    <header class="space-y-4">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-50">
          {pageTitle}
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
          {pageDescription}
        </p>
      </div>
      
      <FilterBar
        allIcon="i-mdi:code-braces"
        total={projects.length}
        items={filterItems}
      />
    </header>

    <div class="fade-in-up animation-delay-200 space-y-6" id="projects-container">
      <!-- Active Projects -->
      {activeProjects.length > 0 && (
        <section class="space-y-3 project-section" data-filter-section="active">
          <h2 class="text-sm font-semibold text-accent-600 dark:text-accent-400 uppercase tracking-wide">
            Active
          </h2>
          
          <div class="grid gap-4 sm:grid-cols-2">
            {activeProjects.map((project) => {
              const primaryLink = project.links[0];
              const hasUrl = Boolean(primaryLink);
              const hasMultipleLinks = project.links.length > 1;
              const Wrapper = hasUrl && !hasMultipleLinks ? 'a' : 'div';
              return (
                <Wrapper
                  {...(hasUrl && !hasMultipleLinks ? { href: primaryLink.href, target: "_blank", rel: "noopener noreferrer" } : {})}
                  class={`group relative block p-6 rounded-2xl bg-white dark:bg-gray-800/50 shadow-sm hover:shadow-md transition-all duration-300 no-underline ${hasUrl ? 'cursor-pointer' : ''}`}
                >
                  <!-- Status indicator -->
                  <div class="absolute top-4 right-4 flex items-center gap-1.5">
                    <span class="relative flex h-2.5 w-2.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/40 px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800">
                      Active
                    </span>
                  </div>
                  
                  <div class="space-y-3">
                    <div class="space-y-1 pr-16">
                      <h3 class="font-bold text-gray-900 dark:text-gray-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors leading-snug">
                        {project.title}
                      </h3>
                      {project.subtitle && (
                        <p class="text-xs font-medium text-accent-600 dark:text-accent-400">
                          {project.subtitle}
                        </p>
                      )}
                      {project.period && (
                        <p class="text-xs text-gray-500 dark:text-gray-500 flex items-center gap-1">
                          <span class="i-mdi:calendar-range"></span>
                          {project.period}
                        </p>
                      )}
                    </div>
                    
                    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed">
                      {project.description}
                    </p>

                    {project.badges.length > 0 && (
                      <div class="flex flex-wrap items-center gap-1.5">
                        {project.badges.map((badge) => (
                          <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-900/30">
                            <span class="i-mdi:sparkles text-emerald-500 text-xs"></span>
                            {badge}
                          </span>
                        ))}
                      </div>
                    )}

                    {project.highlights.length > 0 && (
                      <ul class="space-y-1">
                        {project.highlights.slice(0, 3).map((highlight) => (
                          <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-400">
                            <span class="i-mdi:check-circle-outline text-accent-500 shrink-0 mt-0.5"></span>
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {project.metadata.length > 0 && (
                      <div class="grid gap-2 text-xs sm:grid-cols-2">
                        {project.metadata.slice(0, 4).map((item) => (
                          <div class="rounded-lg bg-gray-50 dark:bg-gray-900/50 px-2 py-1.5">
                            <span class="font-semibold text-gray-500 dark:text-gray-400">{item.label}: </span>
                            <span class="text-gray-700 dark:text-gray-300">{item.value}</span>
                          </div>
                        ))}
                      </div>
                    )}
                    
                    <div class="flex flex-wrap items-center gap-1.5 pt-1">
                      {project.tech.slice(0, 4).map((tag) => (
                        <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-md text-accent-700 dark:text-accent-300 bg-accent-50 dark:bg-accent-900/40 border border-accent-200 dark:border-accent-800">
                          <span class="i-mdi:code-tags text-accent-500 text-xs"></span>
                          {tag}
                        </span>
                      ))}
                      {project.tech.length > 4 && (
                        <span class="text-xs text-gray-500 dark:text-gray-500">+{project.tech.length - 4} more</span>
                      )}
                    </div>
                    
                    {hasMultipleLinks && (
                      <div class="flex flex-wrap items-center gap-2 pt-1">
                        {project.links.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex items-center gap-1 text-xs font-medium text-accent-600 dark:text-accent-400 no-underline hover:text-accent-700 dark:hover:text-accent-300"
                          >
                            {link.icon && <span class={link.icon}></span>}
                            <span>{link.label}</span>
                            <span class="i-mdi:open-in-new text-xs"></span>
                          </a>
                        ))}
                      </div>
                    )}

                    {hasUrl && !hasMultipleLinks && (
                      <div class="flex items-center gap-1 text-xs font-medium text-accent-600 dark:text-accent-400 pt-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <span>{primaryLink.label}</span>
                        <span class="i-mdi:arrow-right"></span>
                      </div>
                    )}
                  </div>
                </Wrapper>
              );
            })}
          </div>
        </section>
      )}

      <!-- Past/Other Projects -->
      {pastProjects.length > 0 && (
        <section class="space-y-3 project-section" data-filter-section="past">
          <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
            Past
          </h2>
          
          <div class="grid gap-4 sm:grid-cols-2">
            {pastProjects.map((project) => {
              const primaryLink = project.links[0];
              const hasUrl = Boolean(primaryLink);
              const hasMultipleLinks = project.links.length > 1;
              const Wrapper = hasUrl && !hasMultipleLinks ? 'a' : 'div';
              return (
                <Wrapper
                  {...(hasUrl && !hasMultipleLinks ? { href: primaryLink.href, target: "_blank", rel: "noopener noreferrer" } : {})}
                  class={`group relative block p-6 rounded-2xl bg-white dark:bg-gray-800/50 shadow-sm hover:shadow-md transition-all duration-300 no-underline ${hasUrl ? 'cursor-pointer' : ''}`}
                >
                  <div class="space-y-3">
                    <div class="space-y-1">
                      <h3 class="font-bold text-gray-900 dark:text-gray-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors leading-snug">
                        {project.title}
                      </h3>
                      {project.subtitle && (
                        <p class="text-xs font-medium text-accent-600 dark:text-accent-400">
                          {project.subtitle}
                        </p>
                      )}
                      {project.period && (
                        <p class="text-xs text-gray-500 dark:text-gray-500 flex items-center gap-1">
                          <span class="i-mdi:calendar-range"></span>
                          {project.period}
                        </p>
                      )}
                    </div>
                    
                    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed">
                      {project.description}
                    </p>

                    {project.badges.length > 0 && (
                      <div class="flex flex-wrap items-center gap-1.5">
                        {project.badges.map((badge) => (
                          <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
                            <span class="i-mdi:tag-outline text-gray-400 text-xs"></span>
                            {badge}
                          </span>
                        ))}
                      </div>
                    )}

                    {project.highlights.length > 0 && (
                      <ul class="space-y-1">
                        {project.highlights.slice(0, 3).map((highlight) => (
                          <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-400">
                            <span class="i-mdi:check-circle-outline text-accent-500 shrink-0 mt-0.5"></span>
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {project.metadata.length > 0 && (
                      <div class="grid gap-2 text-xs sm:grid-cols-2">
                        {project.metadata.slice(0, 4).map((item) => (
                          <div class="rounded-lg bg-gray-50 dark:bg-gray-900/50 px-2 py-1.5">
                            <span class="font-semibold text-gray-500 dark:text-gray-400">{item.label}: </span>
                            <span class="text-gray-700 dark:text-gray-300">{item.value}</span>
                          </div>
                        ))}
                      </div>
                    )}
                    
                    <div class="flex flex-wrap items-center gap-1.5 pt-1">
                      {project.tech.slice(0, 4).map((tag) => (
                        <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-md text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-800">
                          {tag}
                        </span>
                      ))}
                      {project.tech.length > 4 && (
                        <span class="text-xs text-gray-500 dark:text-gray-500">+{project.tech.length - 4} more</span>
                      )}
                    </div>
                    
                    {hasMultipleLinks && (
                      <div class="flex flex-wrap items-center gap-2 pt-1">
                        {project.links.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noreferrer"
                            class="inline-flex items-center gap-1 text-xs font-medium text-accent-600 dark:text-accent-400 no-underline hover:text-accent-700 dark:hover:text-accent-300"
                          >
                            {link.icon && <span class={link.icon}></span>}
                            <span>{link.label}</span>
                            <span class="i-mdi:open-in-new text-xs"></span>
                          </a>
                        ))}
                      </div>
                    )}

                    {hasUrl && !hasMultipleLinks && (
                      <div class="flex items-center gap-1 text-xs font-medium text-accent-600 dark:text-accent-400 pt-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <span>{primaryLink.label}</span>
                        <span class="i-mdi:arrow-right"></span>
                      </div>
                    )}
                  </div>
                </Wrapper>
              );
            })}
          </div>
        </section>
      )}

      {unspecifiedProjects.length > 0 && (
        <section class="space-y-3 project-section" data-filter-section="unspecified">
          <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
            Other
          </h2>

          <div class="grid gap-4 sm:grid-cols-2">
          {unspecifiedProjects.map((project) => {
            const primaryLink = project.links[0];
            const hasUrl = Boolean(primaryLink);
            const hasMultipleLinks = project.links.length > 1;
            const Wrapper = hasUrl && !hasMultipleLinks ? 'a' : 'div';
            return (
              <Wrapper
                {...(hasUrl && !hasMultipleLinks ? { href: primaryLink.href, target: "_blank", rel: "noopener noreferrer" } : {})}
                class={`group relative block p-5 rounded-xl bg-white dark:bg-gray-900/50 border border-gray-200 dark:border-gray-800 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-lg hover:shadow-accent-500/5 transition-all duration-300 no-underline ${hasUrl ? 'cursor-pointer' : ''}`}
              >
                <div class="space-y-3">
                  <h3 class="font-bold text-gray-900 dark:text-gray-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors leading-snug">
                    {project.title}
                  </h3>
                  {project.subtitle && (
                    <p class="text-xs font-medium text-accent-600 dark:text-accent-400">
                      {project.subtitle}
                    </p>
                  )}
                  
                  <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed">
                    {project.description}
                  </p>

                  {project.badges.length > 0 && (
                    <div class="flex flex-wrap items-center gap-1.5">
                      {project.badges.map((badge) => (
                        <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
                          <span class="i-mdi:tag-outline text-gray-400 text-xs"></span>
                          {badge}
                        </span>
                      ))}
                    </div>
                  )}

                  {project.highlights.length > 0 && (
                    <ul class="space-y-1">
                      {project.highlights.slice(0, 3).map((highlight) => (
                        <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-400">
                          <span class="i-mdi:check-circle-outline text-accent-500 shrink-0 mt-0.5"></span>
                          <span>{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  
                  <div class="flex flex-wrap items-center gap-1.5 pt-1">
                    {project.tech.slice(0, 4).map((tag) => (
                      <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-md text-gray-600 dark:text-gray-400 bg-gray-100 dark:bg-gray-800">
                        {tag}
                      </span>
                    ))}
                    {project.tech.length > 4 && (
                      <span class="text-xs text-gray-500 dark:text-gray-500">+{project.tech.length - 4} more</span>
                    )}
                  </div>
                  
                  {hasMultipleLinks && (
                    <div class="flex flex-wrap items-center gap-2 pt-1">
                      {project.links.map((link) => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noreferrer"
                          class="inline-flex items-center gap-1 text-xs font-medium text-accent-600 dark:text-accent-400 no-underline hover:text-accent-700 dark:hover:text-accent-300"
                        >
                          {link.icon && <span class={link.icon}></span>}
                          <span>{link.label}</span>
                          <span class="i-mdi:open-in-new text-xs"></span>
                        </a>
                      ))}
                    </div>
                  )}

                  {hasUrl && !hasMultipleLinks && (
                    <div class="flex items-center gap-1 text-xs font-medium text-accent-600 dark:text-accent-400 pt-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <span>{primaryLink.label}</span>
                      <span class="i-mdi:arrow-right"></span>
                    </div>
                  )}
                </div>
              </Wrapper>
            );
          })}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<script>
  import { setupFilterControls } from "../scripts/ui";

  setupFilterControls();
</script>
