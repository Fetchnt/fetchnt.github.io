---
interface FilterItem {
  filter: string;
  label: string;
  count: number;
  icon: string;
}

interface Props {
  items: FilterItem[];
  allIcon: string;
  total: number;
}

const { items, allIcon, total } = Astro.props;
const visibleItems = items.filter((item) => item.count > 0);
const shouldRender = visibleItems.length > 1;
---

{
  shouldRender && (
    <div class="flex flex-wrap items-center gap-2" role="toolbar" aria-label="Filter sections">
      <button
        type="button"
        data-filter="all"
        data-active="true"
        aria-pressed="true"
        class="filter-btn inline-flex min-h-10 items-center gap-1.5 rounded-full border-none px-3 py-1.5 text-sm cursor-pointer transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-50 dark:focus-visible:ring-offset-gray-900 active bg-accent-100 dark:bg-accent-900/30"
      >
        <span class={`${allIcon} text-base text-accent-600 dark:text-accent-400`} aria-hidden="true"></span>
        <span class="font-medium text-accent-700 dark:text-accent-300">{total}</span>
        <span class="text-accent-600 dark:text-accent-400">all</span>
      </button>
      {
        visibleItems.map((item) => (
          <button
            type="button"
            data-filter={item.filter}
            data-active="false"
            aria-pressed="false"
            class="filter-btn inline-flex min-h-10 items-center gap-1.5 rounded-full border-none px-3 py-1.5 text-sm cursor-pointer transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-50 dark:focus-visible:ring-offset-gray-900 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700"
          >
            <span class={`${item.icon} text-base text-gray-500 dark:text-gray-400`} aria-hidden="true"></span>
            <span class="font-medium text-gray-700 dark:text-gray-300">{item.count}</span>
            <span class="text-gray-500 dark:text-gray-500">{item.label}</span>
          </button>
        ))
      }
    </div>
  )
}
